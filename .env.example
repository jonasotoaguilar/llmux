# LLMux gateway runtime
LLMUX_HOST=0.0.0.0
LLMUX_PORT=8000
LLMUX_VERSION=0.1.0
LLMUX_PROVIDERS_CONFIGURED=[]

# OpenTelemetry (optional; leave empty to disable)
OTEL_SERVICE_NAME=llmux
OTEL_EXPORTER_OTLP_ENDPOINT=

# OpenAI provider (provider-routing-functional-slice / PR1)
# Required when 'openai' is in LLMUX_PROVIDERS_CONFIGURED.
# Empty key, empty OPENAI_MODELS, or a non-http(s) OPENAI_BASE_URL is a
# fail-fast ConfigurationError at startup.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=[]
OPENAI_TIMEOUT_S=30
