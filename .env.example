# LLMux gateway runtime
LLMUX_HOST=0.0.0.0
LLMUX_PORT=8000
LLMUX_VERSION=0.1.0
LLMUX_PROVIDERS_CONFIGURED=[]

# OpenAI provider (PR1: provider-routing-vertical-slice)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=["gpt-4o-mini","gpt-4o"]
OPENAI_TIMEOUT_S=30.0

# OpenTelemetry (optional; leave empty to disable)
OTEL_SERVICE_NAME=llmux
OTEL_EXPORTER_OTLP_ENDPOINT=
